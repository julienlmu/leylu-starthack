#!/usr/bin/env bash
# Blocks committing .env files or things that look like API keys.
if git diff --cached --name-only | grep -E '(^|/)\.env' | grep -vq '\.env\.example'; then
  echo "pre-commit: .env files must not be committed." >&2; exit 1
fi
if git diff --cached -U0 | grep -Eq '^\+.*(sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16})'; then
  echo "pre-commit: the diff contains something that looks like an API key." >&2; exit 1
fi
exit 0
